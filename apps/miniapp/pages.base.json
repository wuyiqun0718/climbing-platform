{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "",
        "navigationBarBackgroundColor": "$brand",
        "navigationBarTextStyle": "$onBrand"
      }
    },
    {
      "path": "pages/cards/index",
      "style": {
        "navigationBarTitleText": "卡包"
      }
    },
    {
      "path": "pages/cards/detail",
      "style": {
        "navigationBarTitleText": "卡详情"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "globalStyle": {
    "navigationBarBackgroundColor": "$surface",
    "navigationBarTextStyle": "$ink",
    "backgroundColor": "$page"
  },
  "tabBar": {
    "color": "$inkMuted",
    "selectedColor": "$ink",
    "backgroundColor": "$surface",
    "borderStyle": "$ink",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/cards/index", "text": "卡包" },
      { "pagePath": "pages/me/index", "text": "我的" }
    ]
  }
}
