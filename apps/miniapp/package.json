{
  "name": "@climb/miniapp",
  "version": "0.0.0",
  "private": true,
  "description": "会员端微信小程序（uni-app + Vue 3）。一套代码，用 GYM=<岩馆> 打出不同岩馆的小程序",
  "scripts": {
    "dev:mp-weixin": "node scripts/uni.mjs dev mp-weixin",
    "dev:h5": "node scripts/uni.mjs dev h5",
    "build:mp-weixin": "node scripts/uni.mjs build mp-weixin",
    "build:h5": "node scripts/uni.mjs build h5",
    "build": "node scripts/uni.mjs build mp-weixin",
    "typecheck": "node scripts/prepare-gym.mjs && vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@climb/api": "workspace:*",
    "@climb/core": "workspace:*",
    "@climb/theme": "workspace:*",
    "@climb/ui-mp": "workspace:*",
    "@climb/utils": "workspace:*",
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "vue": "3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@climb/gym-benchmark": "workspace:*",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-stacktracey": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "typescript": "~5.9.3",
    "vite": "5.2.8",
    "vue-tsc": "^3.3.13"
  }
}
